rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Profil : lecture par son propriétaire uniquement. Aucune écriture côté client.
    match /wy_users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Administrateurs : chacun peut lire seulement son propre document (pour savoir s'il est admin). Aucune écriture côté client.
    match /wy_admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Favoris de jeux : chacun lit seulement sa liste. Écriture par la fonction setGameFavorite.
    match /wy_game_favorites/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Tickets de jackpot : chacun lit seulement ses propres tickets. Écriture par la fonction playJackpot.
    match /wy_jackpot_tickets/{ticketId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    // Réglages publics affichés sur le site (logo, contenu de l'accueil, coordonnées du support) : lisibles par tous.
    // Aucun réglage sensible ici (probabilités, mises et tirages restent dans les fonctions).
    match /wy_settings/branding {
      allow read: if true;
      allow write: if false;
    }
    match /wy_settings/home {
      allow read: if true;
      allow write: if false;
    }
    match /wy_settings/support {
      allow read: if true;
      allow write: if false;
    }

    // Index numéro -> compte : réservé aux Cloud Functions.
    match /wy_phones/{phoneKey} {
      allow read, write: if false;
    }

    // Lucky Number : tirage en cours et derniers numéros tirés, lisibles par tout utilisateur connecté.
    // Écriture réservée aux Cloud Functions. Aucune donnée personnelle.
    match /wy_lucky_draws/{drawId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /wy_settings/lucky-number {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Jackpot : tours et gagnants récents, lisibles par tout utilisateur connecté. Écriture réservée aux fonctions.
    match /wy_jackpot_rounds/{roundId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /wy_settings/jackpot {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Sport : matchs et cotes, lisibles par tout utilisateur connecté. Écriture réservée aux fonctions (import, règlement).
    match /wy_sport_events/{eventId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Compétitions de football : lisibles par tout utilisateur connecté (filtre d'affichage). Écriture par les fonctions.
    match /wy_sport_leagues/{leagueKey} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Réglages de l'administration : lecture réservée aux rôles qui les gèrent (mêmes rôles que la fonction adminGetSettings).
    // Écriture toujours par la fonction adminSaveSettings (contrôle des valeurs et journal d'audit).
    function isAdminIn(roles) {
      return request.auth != null
        && exists(/databases/$(database)/documents/wy_admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/wy_admins/$(request.auth.uid)).data.role in roles;
    }
    match /wy_settings/payments {
      allow read: if isAdminIn(['super_admin', 'finance', 'support']);
      allow write: if false;
    }
    match /wy_settings/referral {
      allow read: if isAdminIn(['super_admin', 'finance', 'support']);
      allow write: if false;
    }
    match /wy_settings/welcome-bonus {
      allow read: if isAdminIn(['super_admin', 'finance', 'support']);
      allow write: if false;
    }
    match /wy_settings/crash {
      allow read: if isAdminIn(['super_admin', 'support']);
      allow write: if false;
    }
    match /wy_settings/mystery-box {
      allow read: if isAdminIn(['super_admin', 'support']);
      allow write: if false;
    }
    match /wy_settings/lucky-spin {
      allow read: if isAdminIn(['super_admin', 'support']);
      allow write: if false;
    }

    // Tout le reste est fermé par défaut.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
